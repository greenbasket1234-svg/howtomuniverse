# HOWTOM 유니버스 v1.2.0 — Railway/운영 환경변수 예시

# 프론트와 백엔드를 같은 Railway 서비스에서 제공하면 비워둡니다.
VITE_API_URL=

# HOWTOM 콘텐츠 제작소 별도 웹앱 URL
VITE_CONTENT_STUDIO_URL=

# 계정 보관함용 별도 Secret Store가 실제 연결되기 전에는 false 유지
VITE_SECURE_CREDENTIAL_BACKEND=false

# 관리자 로그인 — Railway Variables에 반드시 설정
HOWTOM_ADMIN_EMAIL=
HOWTOM_ADMIN_PASSWORD=
HOWTOM_ADMIN_NAME=관리자
HOWTOM_ADMIN_NICKNAME=
# 최소 32자 이상의 임의 문자열 권장
JWT_SECRET=

# 영구 저장 위치
# Railway Volume을 /data에 마운트했다면 아래처럼 지정하세요.
HOWTOM_DATA_DIR=/data

# 블로그 원고 작성 — 외부 AI API (설정하지 않으면 서버 규칙 기반 초안으로 동작)
# provider: anthropic | openai | custom (비워두면 미사용)
BLOG_AI_PROVIDER=
BLOG_AI_API_KEY=
# provider가 custom일 때만 사용 — { systemPrompt, userPrompt, brief } 를 받아
# { titles: string[], blocks: {type,title,text}[] } 를 반환하는 엔드포인트
BLOG_AI_API_URL=
# 비워두면 provider별 기본 모델 사용 (anthropic: claude-sonnet-4-6, openai: gpt-4o-mini)
BLOG_AI_MODEL=

# Meta(Facebook/Instagram) 광고 API 연동
# Business Manager의 System User Access Token (ads_read 권한, 만료 없음 권장)
META_ACCESS_TOKEN=
# 비워두면 v21.0 사용
META_API_VERSION=

# 선택 연동
GOOGLE_SHEETS_WEBHOOK_URL=
NOTION_WEBHOOK_URL=
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_VERSION=2026-03-11

# Production에서는 강제로 api가 사용됩니다. 개발환경도 기본 api입니다.
VITE_REPOSITORY_MODE=api

# 광고 API Credential DB 암호화용 32바이트 키(64자리 hex)
SECRET_ENCRYPTION_KEY=

# PostgreSQL 전환 시 설정
DATABASE_URL=
