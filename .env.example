# HOWTOM 유니버스 환경변수 예시

# 백엔드 API URL. 비워두면 같은 도메인의 /api를 사용합니다.
VITE_API_URL=

# 로컬 데모 모드. true여도 localhost/127.0.0.1에서만 관리자 데모가 자동 활성화됩니다.
VITE_DEMO_MODE=true

# 공개 도메인에서도 관리자 데모를 허용할지 여부.
# 보안상 기본 false 유지. 정말 의도한 외부 데모 환경에서만 true로 설정하세요.
VITE_ALLOW_REMOTE_DEMO=false

# 실제 비밀번호/API Secret을 저장하는 보안 백엔드가 연결되었을 때만 true로 변경합니다.
# 현재 프론트엔드 계정 보관함은 자격증명을 저장하지 않습니다.
VITE_SECURE_CREDENTIAL_BACKEND=false

# 서버(server.mjs) 공개 환경에서 인증 없는 내장 데모 API를 강제로 허용하는 예외 스위치.
# Railway/production에서는 기본적으로 내장 데모 API가 차단됩니다.
HOWTOM_ALLOW_INSECURE_DEMO_API=false

# ---------------------------------------------------------------------
# 로그인 인증 (server.mjs 내장 JWT 백엔드) — Railway 배포 시 필수
# 3개 모두 설정하지 않으면 로그인 API가 500 오류를 반환합니다.
# ---------------------------------------------------------------------
# 관리자 로그인 아이디 (이메일 형식이 아니어도 됩니다)
HOWTOM_ADMIN_EMAIL=
# 관리자 로그인 비밀번호 (평문으로 저장되지만 Railway 환경변수는 암호화되어 보관됩니다)
HOWTOM_ADMIN_PASSWORD=
# JWT 서명용 비밀키. 32자 이상 랜덤 문자열 권장 (예: openssl rand -hex 32)
JWT_SECRET=

# 선택: Google Sheets / Notion 연동
GOOGLE_SHEETS_WEBHOOK_URL=
NOTION_WEBHOOK_URL=
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_VERSION=2026-03-11
