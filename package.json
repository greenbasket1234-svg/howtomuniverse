{
  "name": "howtom-universe",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "node server.mjs",
    "dev:no-open": "node scripts/dev-server.mjs --no-open",
    "setup": "npm install --registry=https://registry.npmjs.org/",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "dev:static": "node server.mjs",
    "dev:source": "node scripts/dev-server.mjs --source",
    "test:metrics": "node scripts/metrics-integration-test.mjs",
    "build:vite": "tsc --noEmit && vite build",
    "audit:data": "node scripts/data-source-audit.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.383.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^4.1.10"
  }
}
